# Camera RTSP account (same network as this computer / the Raspberry Pi)
RTSP_USER=your_username
RTSP_PASSWORD=your_password
# Camera IP address on the local network
RTSP_HOST=192.168.1.50
RTSP_PORT=554
# Stream path is camera-specific (check the camera's manual), e.g. /stream1 or /live
RTSP_PATH=/stream1